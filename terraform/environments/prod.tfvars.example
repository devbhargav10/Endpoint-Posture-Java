environment                     = "prod"
aws_region                      = "ap-south-1" # Example only; choose the deployment region.
vpc_cidr                        = "10.60.0.0/16" # Confirm no overlap with VPN-connected sites.
public_subnet_cidrs             = ["10.60.0.0/24", "10.60.1.0/24"]
application_subnet_cidrs        = ["10.60.10.0/24", "10.60.11.0/24"]
data_subnet_cidrs               = ["10.60.20.0/24", "10.60.21.0/24"]
edge_ingress_cidrs              = [] # Add only approved ingress ranges after security review.
nat_gateway_enabled             = true
nat_gateway_per_az              = true
postgres_engine_version         = "16.9" # Example only; check RDS engine versions in the chosen region.
postgres_instance_class         = "db.m6g.large" # Capacity placeholder; size from load and recovery targets.
postgres_allocated_storage      = 100
postgres_max_allocated_storage  = 500
postgres_backup_retention_days  = 35
postgres_multi_az               = true
postgres_deletion_protection    = true
postgres_skip_final_snapshot    = false
tags = {
  Owner = "platform"
}
