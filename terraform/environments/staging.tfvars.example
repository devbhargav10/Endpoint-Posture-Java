environment                     = "staging"
aws_region                      = "ap-south-1" # Example only; choose the deployment region.
vpc_cidr                        = "10.50.0.0/16" # Confirm no overlap with VPN-connected sites.
public_subnet_cidrs             = ["10.50.0.0/24", "10.50.1.0/24"]
application_subnet_cidrs        = ["10.50.10.0/24", "10.50.11.0/24"]
data_subnet_cidrs               = ["10.50.20.0/24", "10.50.21.0/24"]
edge_ingress_cidrs              = []
nat_gateway_enabled             = true
nat_gateway_per_az              = false
postgres_engine_version         = "16.9" # Example only; check RDS engine versions in the chosen region.
postgres_instance_class         = "db.t4g.small"
postgres_allocated_storage      = 50
postgres_max_allocated_storage  = 200
postgres_backup_retention_days  = 14
postgres_multi_az               = false
postgres_deletion_protection    = true
postgres_skip_final_snapshot    = false
tags = {
  Owner = "platform"
}
